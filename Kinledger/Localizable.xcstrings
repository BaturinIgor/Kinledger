    "Backup is not on, so there are no links.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia está desactivada, así que no hay enlaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde est désactivée, il n’y a donc aucun lien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup ist aus, es gibt also keine Links."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup non è attivo, quindi non ci sono link."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup não está ativado, então não há links."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Back-up staat uit, dus er zijn geen links."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup är inte på, så det finns inga länkar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup er ikke slået til, så der er ingen links."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetskopi er ikke på, så det finnes ingen lenker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zapasowa jest wyłączona, więc nie ma linków."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия выключена, поэтому ссылок нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервну копію вимкнено, тож посилань немає."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme açık değil, bu yüzden bağlantı yok."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップがオフなので、リンクはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업이 꺼져 있어 링크가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份未开启，因此没有链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份未開啟，因此沒有連結。"
          }
        }
      }
    },
    "Backup is not on, so there is no cloud account to delete.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia está desactivada, así que no hay cuenta en la nube que eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde est désactivée, il n’y a donc aucun compte cloud à supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup ist aus, es gibt also kein Cloud-Konto zum Löschen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup non è attivo, quindi non c’è nessun account cloud da eliminare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup não está ativado, então não há conta na nuvem para apagar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Back-up staat uit, dus er is geen cloudaccount om te verwijderen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup är inte på, så det finns inget molnkonto att radera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup er ikke slået til, så der er ingen skykonto at slette."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetskopi er ikke på, så det finnes ingen skykonto å slette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zapasowa jest wyłączona, więc nie ma konta w chmurze do usunięcia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия выключена, поэтому облачного аккаунта нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервну копію вимкнено, тож хмарного облікового запису немає."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme açık değil, bu yüzden silinecek bulut hesabı yok."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップがオフなので、削除するクラウドアカウントはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업이 꺼져 있어 삭제할 클라우드 계정이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份未开启，因此没有可删除的云端账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份未開啟，因此沒有可刪除的雲端帳號。"
          }
        }
      }
    },
