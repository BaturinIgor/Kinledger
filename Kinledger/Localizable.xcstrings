          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Gelöschte Einträge bleiben %lld Tag hier und werden dann endgültig entfernt. Wiederhergestellte Einträge behalten ihren Verlauf."
                }
              },
              "other": {
                "stringUnit": {
