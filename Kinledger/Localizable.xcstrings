    "Free for 7 days, then the plan you chose, renewing automatically until you cancel. Cancel in Settings any time, at least 24 hours before the trial or period ends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante 7 días y después el plan elegido, con renovación automática hasta que canceles. Cancela en Ajustes cuando quieras, al menos 24 horas antes de que termine la prueba o el periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant 7 jours, puis la formule choisie, renouvelée automatiquement jusqu’à résiliation. Résiliez dans Réglages à tout moment, au moins 24 heures avant la fin de l’essai ou de la période."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "7 Tage kostenlos, danach der gewählte Plan, der sich automatisch verlängert, bis du kündigst. Kündige jederzeit in den Einstellungen, spätestens 24 Stunden vor Ende des Testzeitraums oder der Laufzeit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per 7 giorni, poi il piano scelto, con rinnovo automatico finché non disdici. Disdici in Impostazioni quando vuoi, almeno 24 ore prima della fine della prova o del periodo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis por 7 dias, depois o plano escolhido, com renovação automática até você cancelar. Cancele nos Ajustes a qualquer momento, pelo menos 24 horas antes do fim do teste ou do período."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dagen gratis, daarna het gekozen abonnement, dat automatisch wordt verlengd tot je opzegt. Zeg op in Instellingen wanneer je wilt, minstens 24 uur voor het einde van de proefperiode of termijn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i 7 dagar, sedan den plan du valt, som förnyas automatiskt tills du avslutar. Avsluta i Inställningar när som helst, minst 24 timmar innan provperioden eller perioden tar slut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i 7 dage, derefter den plan, du har valgt, som fornyes automatisk, indtil du opsiger. Opsig i Indstillinger når som helst, mindst 24 timer før prøveperioden eller perioden slutter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i 7 dager, deretter planen du valgte, som fornyes automatisk til du sier opp. Si opp i Innstillinger når som helst, minst 24 timer før prøveperioden eller perioden er over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "7 dni za darmo, potem wybrany plan odnawiany automatycznie, dopóki go nie anulujesz. Anuluj w Ustawieniach w dowolnej chwili, najpóźniej 24 godziny przed końcem okresu próbnego lub okresu rozliczeniowego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дней бесплатно, затем выбранный план с автоматическим продлением, пока вы не отмените. Отменить можно в Настройках в любой момент, не позднее чем за 24 часа до конца пробного периода или срока подписки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "7 днів безкоштовно, потім вибраний план з автоматичним продовженням, доки ви не скасуєте. Скасувати можна в Параметрах будь-коли, не пізніше ніж за 24 години до кінця пробного періоду чи терміну підписки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gün ücretsiz, ardından seçtiğiniz plan; iptal edene kadar otomatik olarak yenilenir. Deneme süresi veya dönem bitmeden en az 24 saat önce, istediğiniz zaman Ayarlar’dan iptal edin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間無料、その後は解約するまで選択したプランが自動更新されます。「設定」からいつでも解約できます（無料期間または現在の期間が終了する24時間前まで）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일 동안 무료로 이용한 후, 해지할 때까지 선택한 요금제가 자동 갱신됩니다. 설정에서 언제든지 해지할 수 있으며, 체험 기간이나 이용 기간이 끝나기 최소 24시간 전에 해지해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用 7 天，之后按您选择的方案自动续订，直到您取消为止。您可以随时在“设置”中取消，但需在试用期或订阅期结束前至少 24 小时取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費試用 7 天，之後依您選擇的方案自動續訂，直到您取消為止。您可以隨時在「設定」中取消，但須在試用期或訂閱期結束前至少 24 小時取消。"
          }
        }
      }
    },
    "Free forever: logging, totals, backup and exporting all your data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis para siempre: registros, totales, copia de seguridad y exportación de todos tus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pour toujours : saisie, totaux, sauvegarde et export de toutes vos données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer kostenlos: Erfassen, Summen, Backup und Export all deiner Daten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per sempre: annotazioni, totali, backup ed esportazione di tutti i dati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis para sempre: registros, totais, backup e exportação de todos os seus dados."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd gratis: noteren, totalen, back-up en al je gegevens exporteren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis för alltid: anteckningar, summor, backup och export av alla dina data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for altid: notering, totaler, backup og eksport af alle dine data."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis for alltid: notering, summer, sikkerhetskopi og eksport av alle dataene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za darmo na zawsze: wpisy, sumy, kopia zapasowa i eksport wszystkich danych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно навсегда: записи, итоги, резервная копия и выгрузка всех данных."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно назавжди: записи, підсумки, резервна копія й вивантаження всіх даних."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonsuza dek ücretsiz: kayıt, toplamlar, yedekleme ve tüm verilerinizi dışa aktarma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ずっと無料：記録、合計、バックアップ、全データの書き出し。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평생 무료: 기록, 합계, 백업, 모든 데이터 내보내기."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久免费：记录、汇总、备份和导出全部数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久免費：記錄、加總、備份和匯出所有資料。"
          }
        }
      }
    },
