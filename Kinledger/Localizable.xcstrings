    "Nothing is sent until you review it. You can turn the link off any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía nada hasta que lo revises. Puedes desactivar el enlace cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est envoyé avant que vous l’ayez relu. Vous pouvez désactiver le lien à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gesendet, bevor du es geprüft hast. Den Link kannst du jederzeit ausschalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene inviato nulla finché non lo controlli. Puoi disattivare il link quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado antes de você revisar. Você pode desativar o link quando quiser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets verstuurd voordat je het bekeken hebt. Je kunt de link altijd uitzetten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget skickas förrän du har granskat det. Du kan stänga av länken när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet sendes, før du har gennemgået det. Du kan slå linket fra når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting sendes før du har sett over det. Du kan slå av lenken når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie wysłane, dopóki tego nie sprawdzisz. Link możesz wyłączyć w każdej chwili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не отправляется, пока вы не проверите. Ссылку можно отключить в любой момент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не надсилається, доки ви не перевірите. Посилання можна вимкнути будь-коли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz gözden geçirmeden hiçbir şey gönderilmez. Bağlantıyı istediğiniz zaman kapatabilirsiniz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するまで何も送信されません。リンクはいつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토하기 전에는 아무것도 보내지 않습니다. 링크는 언제든지 끌 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您确认之前不会发送任何内容。您可以随时关闭链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您確認之前不會傳送任何內容。您可以隨時關閉連結。"
          }
        }
      }
    },
