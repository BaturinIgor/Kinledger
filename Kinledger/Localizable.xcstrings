    "Kinledger could not open its storage on this iPhone, so new entries are not being kept. Restart the app. (%@)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger no puede abrir su almacenamiento en este iPhone, así que los nuevos registros no se guardan. Reinicia la app. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger ne peut pas ouvrir son stockage sur cet iPhone : les nouvelles entrées ne sont pas conservées. Redémarrez l’app. (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger kann seinen Speicher auf diesem iPhone nicht öffnen, neue Einträge werden also nicht gespeichert. Starte die App neu. (%@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger non riesce ad aprire l’archivio su questo iPhone, quindi le nuove voci non vengono salvate. Riavvia l’app. (%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kinledger não consegue abrir o armazenamento neste iPhone, então novos registros não estão sendo guardados. Reinicie o app. (%@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger kan zijn opslag op deze iPhone niet openen, dus nieuwe items worden niet bewaard. Start de app opnieuw. (%@)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger kan inte öppna sin lagring på den här iPhonen, så nya poster sparas inte. Starta om appen. (%@)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger kan ikke åbne sit lager på denne iPhone, så nye poster gemmes ikke. Genstart appen. (%@)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger får ikke åpnet lagringen sin på denne iPhonen, så nye oppføringer blir ikke tatt vare på. Start appen på nytt. (%@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger nie może otworzyć swojej pamięci na tym iPhonie, więc nowe wpisy nie są zapisywane. Uruchom aplikację ponownie. (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger не может открыть хранилище на этом iPhone, поэтому новые записи не сохраняются. Перезапустите приложение. (%@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger не може відкрити сховище на цьому iPhone, тому нові записи не зберігаються. Перезапустіть застосунок. (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger bu iPhone’da depolama alanını açamıyor, bu yüzden yeni kayıtlar saklanmıyor. Uygulamayı yeniden başlatın. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KinledgerがこのiPhoneの保存領域を開けないため、新しい記録は保存されていません。アプリを再起動してください。（%@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger가 이 iPhone의 저장 공간을 열 수 없어 새 기록이 저장되지 않습니다. 앱을 다시 시작하세요. (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger 无法打开此 iPhone 上的存储空间，新记录没有被保存。请重新启动应用。（%@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinledger 無法開啟此 iPhone 上的儲存空間，新紀錄沒有被儲存。請重新啟動 App。（%@）"
          }
        }
      }
    },
