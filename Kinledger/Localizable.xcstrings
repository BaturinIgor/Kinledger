    "You get a spreadsheet (date, description, category, amount, receipt file) and a folder of receipt photos named to match.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibes una hoja de cálculo (fecha, descripción, categoría, importe, archivo del recibo) y una carpeta de fotos de recibos con los mismos nombres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous obtenez un tableau (date, description, catégorie, montant, fichier du reçu) et un dossier de photos de reçus portant les mêmes noms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bekommst eine Tabelle (Datum, Beschreibung, Kategorie, Betrag, Belegdatei) und einen Ordner mit passend benannten Belegfotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un foglio di calcolo (data, descrizione, categoria, importo, file della ricevuta) e una cartella di foto delle ricevute con nomi corrispondenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você recebe uma planilha (data, descrição, categoria, valor, arquivo do recibo) e uma pasta de fotos de recibos com nomes correspondentes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt een spreadsheet (datum, omschrijving, categorie, bedrag, bonbestand) en een map met bonfoto’s met bijpassende namen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får ett kalkylblad (datum, beskrivning, kategori, belopp, kvittofil) och en mapp med kvittofoton med matchande namn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får et regneark (dato, beskrivelse, kategori, beløb, kvitteringsfil) og en mappe med kvitteringsfotos med tilsvarende navne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får et regneark (dato, beskrivelse, kategori, beløp, kvitteringsfil) og en mappe med kvitteringsbilder med samsvarende navn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymasz arkusz (data, opis, kategoria, kwota, plik paragonu) i folder ze zdjęciami paragonów o pasujących nazwach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получите таблицу (дата, описание, категория, сумма, файл чека) и папку с фото чеков с теми же названиями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви отримаєте таблицю (дата, опис, категорія, сума, файл чека) і папку з фото чеків з тими самими назвами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tablo (tarih, açıklama, kategori, tutar, fiş dosyası) ve adları eşleşen fiş fotoğraflarından oluşan bir klasör alırsınız."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表（日付、内容、カテゴリ、金額、領収書ファイル）と、名前をそろえた領収書の写真フォルダを受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스프레드시트(날짜, 내용, 카테고리, 금액, 영수증 파일)와 이름을 맞춘 영수증 사진 폴더를 받게 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您会得到一份表格（日期、说明、类别、金额、收据文件）和一个按相同名称命名的收据照片文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您會得到一份試算表（日期、說明、類別、金額、收據檔案）和一個名稱相符的收據照片資料夾。"
          }
        }
      }
    },
    "You spent %@ with %@, visited %@ and paid %@ yourself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasaste %1$@ con %2$@, fuiste %3$@ de visita y pagaste %4$@ de tu bolsillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez passé %1$@ avec %2$@, lui avez rendu visite %3$@ et avez payé %4$@ de votre poche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ mit %2$@ verbracht, warst %3$@ zu Besuch und hast %4$@ selbst bezahlt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai passato %1$@ con %2$@, hai fatto visita %3$@ e hai pagato %4$@ di tasca tua."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você passou %1$@ com %2$@, esteve lá %3$@ e pagou %4$@ do próprio bolso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je was %1$@ bij %2$@, ging %3$@ langs en betaalde %4$@ uit eigen zak."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tillbringade %1$@ med %2$@, hälsade på %3$@ och betalade %4$@ ur egen ficka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brugte %1$@ med %2$@, kom på besøg %3$@ og betalte %4$@ af egen lomme."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brukte %1$@ med %2$@, var på besøk %3$@ og betalte %4$@ av egen lomme."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@: razem %1$@, odwiedziny %3$@, z własnej kieszeni %4$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@: вы провели рядом %1$@, навестили %3$@ и заплатили %4$@ из своего кармана."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@: ви провели поруч %1$@, навідали %3$@ і заплатили %4$@ з власної кишені."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ile %1$@ geçirdiniz, %3$@ ziyaret ettiniz ve cebinizden %4$@ ödediniz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@と%1$@を過ごし、%3$@訪問し、%4$@を自己負担しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 곁에서 %1$@ 보냈고, %3$@ 방문했으며, 직접 낸 돈은 %4$@입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您陪伴%2$@ %1$@，探望 %3$@，自付 %4$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您陪伴%2$@ %1$@，探望 %3$@，自付 %4$@。"
          }
        }
      }
    }
  },
  "version": "1.0"
}