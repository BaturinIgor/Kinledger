    "Apple did not confirm. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no lo confirmó. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas confirmé. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat nicht bestätigt. Versuch es noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non ha confermato. Riprova."
          }
