        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não confirmou. Tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple heeft niet bevestigd. Probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bekräftade inte. Försök igen."
          }
        },
        "da": {
