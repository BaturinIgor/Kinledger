        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收报告的家人"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接收報告的家人"
          }
        }
      }
    },
    "Family open it in any browser, no app or account. Turn links off any time in Me.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La familia lo abre en cualquier navegador, sin app ni cuenta. Desactiva los enlaces cuando quieras en Yo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La famille l’ouvre dans n’importe quel navigateur, sans app ni compte. Désactivez les liens à tout moment dans Moi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Familie öffnet ihn in jedem Browser, ohne App oder Konto. Links kannst du jederzeit unter „Ich“ ausschalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La famiglia lo apre in qualsiasi browser, senza app né account. Disattiva i link quando vuoi da Io."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A família abre em qualquer navegador, sem app nem conta. Desative os links quando quiser em Eu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Familie opent hem in elke browser, zonder app of account. Zet links altijd uit via Ik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Familjen öppnar den i valfri webbläsare, utan app eller konto. Stäng av länkar när som helst under Jag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Familien åbner det i en hvilken som helst browser, uden app eller konto. Slå links fra når som helst under Mig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Familien åpner den i hvilken som helst nettleser, uten app eller konto. Slå av lenker når som helst under Meg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodzina otwiera go w dowolnej przeglądarce, bez aplikacji i konta. Linki możesz wyłączyć w każdej chwili w sekcji Ja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семья открывает её в любом браузере, без приложения и аккаунта. Отключить ссылки можно в любой момент в Профиле."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Родина відкриває його в будь-якому браузері, без застосунку й облікового запису. Вимкнути посилання можна будь-коли в Профілі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aileniz herhangi bir tarayıcıda, uygulama ya da hesap olmadan açar. Bağlantıları istediğiniz zaman Ben bölümünden kapatın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族はどのブラウザでも開けます。アプリもアカウントも不要です。リンクは「自分」からいつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족은 앱이나 계정 없이 어떤 브라우저에서든 열 수 있습니다. 링크는 ‘나’에서 언제든지 끌 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家人可以在任何浏览器中打开，无需应用或账户。可随时在“我”中关闭链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家人可以在任何瀏覽器中開啟，不需要 App 或帳號。可隨時在「我」中關閉連結。"
          }
        }
      }
    },
