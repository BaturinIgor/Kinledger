    "Totals fill in as you log. Most people add the first entry in under 10 seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los totales se rellenan a medida que anotas. La mayoría añade su primer registro en menos de 10 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les totaux se remplissent au fil des saisies. La plupart des gens ajoutent leur première entrée en moins de 10 secondes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Summen füllen sich beim Erfassen. Die meisten legen den ersten Eintrag in unter 10 Sekunden an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I totali si riempiono mentre annoti. Quasi tutti aggiungono la prima voce in meno di 10 secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os totais se preenchem conforme você anota. A maioria adiciona o primeiro registro em menos de 10 segundos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalen vullen zich terwijl je noteert. De meeste mensen voegen hun eerste item toe in minder dan 10 seconden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Summorna fylls i när du antecknar. De flesta lägger till sin första post på under 10 sekunder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalerne fyldes ud, mens du noterer. De fleste tilføjer den første post på under 10 sekunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Summene fylles ut mens du noterer. De fleste legger inn den første oppføringen på under 10 sekunder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumy uzupełniają się w miarę zapisywania. Większość osób dodaje pierwszy wpis w mniej niż 10 sekund."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоги заполняются по мере записей. Большинство добавляет первую запись меньше чем за 10 секунд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підсумки заповнюються з кожним записом. Більшість додає перший запис менш ніж за 10 секунд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplamlar siz kaydettikçe dolar. Çoğu kişi ilk kaydını 10 saniyeden kısa sürede ekler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録するたびに合計が更新されます。ほとんどの人は10秒以内に最初の記録を追加しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록할수록 합계가 채워집니다. 대부분 첫 기록을 10초 안에 추가합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录越多，汇总越完整。大多数人在 10 秒内就能添加第一条记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄越多，加總越完整。大多數人在 10 秒內就能新增第一筆紀錄。"
          }
        }
      }
    },
