    "Deleted entries stay here for %lld days, then they are removed for good. Restored entries keep their history.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deleted entries stay here for %lld day, then they are removed for good. Restored entries keep their history."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deleted entries stay here for %lld days, then they are removed for good. Restored entries keep their history."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los registros eliminados se quedan aquí %lld día y luego se borran para siempre. Los restaurados conservan su historial."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los registros eliminados se quedan aquí %lld días y luego se borran para siempre. Los restaurados conservan su historial."
