              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les entrées supprimées restent ici %lld jour, puis sont effacées définitivement. Les entrées restaurées gardent leur historique."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les entrées supprimées restent ici %lld jours, puis sont effacées définitivement. Les entrées restaurées gardent leur historique."
