    "Everything you log shows up here, newest first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que anotas aparece aquí, lo más reciente primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous notez apparaît ici, du plus récent au plus ancien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du erfasst, erscheint hier, das Neueste zuerst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che annoti compare qui, dal più recente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você anota aparece aqui, do mais recente para o mais antigo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je noteert verschijnt hier, nieuwste eerst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du antecknar visas här, nyast först."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, hvad du noterer, vises her, nyeste først."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du noterer, vises her, nyeste først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co zapiszesz, pojawia się tutaj, od najnowszych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляется всё, что вы записываете, сначала новое."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут з’являється все, що ви записуєте, спочатку нове."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz her şey burada, en yenisi önce görünür."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録したものはすべて、新しい順にここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 모든 내용이 최신순으로 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您记录的所有内容都会按时间从新到旧显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您記錄的所有內容都會依新到舊顯示在這裡。"
          }
        }
      }
    },
