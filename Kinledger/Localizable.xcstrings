    "Waiting for approval. Pro turns on as soon as it is approved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Pro se activa en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation. Pro s’activera dès qu’il sera approuvé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Genehmigung. Pro wird aktiv, sobald sie erteilt ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione. Pro si attiva appena viene approvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. O Pro é ativado assim que for aprovado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht op goedkeuring. Pro gaat aan zodra het is goedgekeurd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på godkännande. Pro slås på så fort det godkänns."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkendelse. Pro slås til, så snart det er godkendt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkjenning. Pro slås på så snart det er godkjent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekamy na zgodę. Pro włączy się, gdy tylko zostanie zatwierdzone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ждём одобрения. Pro включится сразу после него."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чекаємо схвалення. Pro увімкнеться одразу після нього."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bekleniyor. Onaylanır onaylanmaz Pro açılır."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。承認されるとすぐにProが有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인을 기다리는 중입니다. 승인되는 즉시 Pro가 켜집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待批准。获得批准后 Pro 会立即开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待核准。核准後 Pro 會立即開啟。"
          }
        }
      }
    },
