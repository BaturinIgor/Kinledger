    "Once a month they get a private report with your hours and costs. They don't need the app or an account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al mes reciben un informe privado con tus horas y gastos. No necesitan la app ni una cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par mois, ils reçoivent un rapport privé avec vos heures et vos frais. Ils n’ont besoin ni de l’app ni d’un compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal im Monat bekommen sie einen privaten Bericht mit deinen Stunden und Kosten. Sie brauchen weder die App noch ein Konto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta al mese ricevono un resoconto privato con le tue ore e le tue spese. Non serve l’app né un account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por mês eles recebem um relatório privado com suas horas e gastos. Não precisam do app nem de conta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer per maand krijgen ze een privéverslag met je uren en kosten. Ze hebben geen app of account nodig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En gång i månaden får de en privat rapport med dina timmar och kostnader. De behöver varken appen eller ett konto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gang om måneden får de en privat rapport med dine timer og udgifter. De behøver hverken appen eller en konto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En gang i måneden får de en privat rapport med timene og utgiftene dine. De trenger verken appen eller en konto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz w miesiącu dostają prywatny raport z twoimi godzinami i kosztami. Nie potrzebują aplikacji ani konta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в месяц они получают личный отчёт с вашими часами и расходами. Им не нужны ни приложение, ни аккаунт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на місяць вони отримують особистий звіт із вашими годинами й витратами. Їм не потрібні ні застосунок, ні обліковий запис."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayda bir kez saatlerinizi ve masraflarınızı gösteren özel bir rapor alırlar. Uygulamaya ya da hesaba ihtiyaçları yoktur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月に一度、あなたが費やした時間と費用をまとめた非公開レポートが届きます。アプリもアカウントも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달에 한 번 나의 돌봄 시간과 비용이 담긴 비공개 보고서를 받습니다. 앱이나 계정은 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们每月会收到一份私密报告，包含您的照护时长和花费。无需应用或账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "他們每月會收到一份私密報告，包含您的照護時數和花費。不需要 App 或帳號。"
          }
        }
      }
    },
    "Only you see it unless you share": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la ves tú, salvo que la compartas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous seul la voyez, sauf si vous la partagez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur du siehst sie, außer du teilst sie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vedi solo tu, a meno che tu non la condivida"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só você vê, a menos que compartilhe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen jij ziet dit, tenzij je het deelt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara du ser den, om du inte delar den"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun du kan se den, medmindre du deler den"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare du ser det, med mindre du deler det"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widzisz ją tylko ty, chyba że ją udostępnisz"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видите только вы, пока не поделитесь"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бачите лише ви, поки не поділитеся"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşmadığınız sürece yalnızca siz görürsünüz"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有しない限り、あなただけが見ることができます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하지 않는 한 나만 볼 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您分享，否则只有您能看到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非您分享，否則只有您看得到"
          }
        }
      }
    },
