    "Sign in with the same Apple account you used for backup. Entries, receipt photos and who you care for come back to this iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con la misma cuenta de Apple que usaste para la copia. Los registros, las fotos de recibos y la persona a la que cuidas vuelven a este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec le même compte Apple que pour la sauvegarde. Les entrées, les photos de reçus et la personne dont vous vous occupez reviennent sur cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit demselben Apple-Account an wie beim Backup. Einträge, Belegfotos und die Person, um die du dich kümmerst, kommen auf dieses iPhone zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con lo stesso account Apple usato per il backup. Voci, foto delle ricevute e la persona di cui ti prendi cura tornano su questo iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão com a mesma conta Apple usada no backup. Registros, fotos de recibos e a pessoa de quem você cuida voltam para este iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in met hetzelfde Apple-account als voor de back-up. Items, bonfoto’s en voor wie je zorgt komen terug op deze iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med samma Apple-konto som du använde för backup. Poster, kvittofoton och den du tar hand om kommer tillbaka till den här iPhonen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind med den samme Apple-konto, som du brugte til backup. Poster, kvitteringsfotos og den, du passer på, kommer tilbage til denne iPhone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på med den samme Apple-kontoen som du brukte til sikkerhetskopien. Oppføringer, kvitteringsbilder og den du tar vare på, kommer tilbake til denne iPhonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się tym samym kontem Apple, którego używasz do kopii. Wpisy, zdjęcia paragonów i osoba, którą się opiekujesz, wrócą na ten iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите с тем же Аккаунтом Apple, что и для резервной копии. Записи, фото чеков и данные о том, о ком вы заботитесь, вернутся на этот iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть із тим самим обліковим записом Apple, що й для резервної копії. Записи, фото чеків і дані про те, про кого ви дбаєте, повернуться на цей iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme için kullandığınız Apple hesabıyla giriş yapın. Kayıtlar, fiş fotoğrafları ve baktığınız kişinin bilgileri bu iPhone’a geri gelir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップに使ったのと同じAppleアカウントでサインインしてください。記録、領収書の写真、介護している方の情報がこのiPhoneに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에 사용한 것과 같은 Apple 계정으로 로그인하세요. 기록, 영수증 사진, 돌보는 분의 정보가 이 iPhone으로 돌아옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用备份时的同一个 Apple 账户登录。记录、收据照片以及您照护对象的信息都会回到这台 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用備份時的同一個 Apple 帳號登入。紀錄、收據照片以及您照護對象的資料都會回到這支 iPhone。"
          }
        }
      }
    },
