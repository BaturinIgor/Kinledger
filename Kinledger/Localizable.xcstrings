    "Saved on this iPhone only. Turn on cloud backup in Me.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado solo en este iPhone. Activa la copia en la nube en Yo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré uniquement sur cet iPhone. Activez la sauvegarde cloud dans Moi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem iPhone gespeichert. Schalte das Cloud-Backup unter „Ich“ ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato solo su questo iPhone. Attiva il backup nel cloud in Io."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo só neste iPhone. Ative o backup na nuvem em Eu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bewaard op deze iPhone. Zet de cloudback-up aan via Ik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparat bara på den här iPhonen. Slå på molnbackup under Jag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun gemt på denne iPhone. Slå skybackup til under Mig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare lagret på denne iPhonen. Slå på skysikkerhetskopi under Meg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano tylko na tym iPhonie. Włącz kopię w chmurze w sekcji Ja."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено только на этом iPhone. Включите облачную копию в Профиле."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережено лише на цьому iPhone. Увімкніть хмарну копію в Профілі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu iPhone’a kaydedildi. Ben bölümünde bulut yedeklemeyi açın."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneにのみ保存済み。「自分」でクラウドバックアップをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에만 저장됨. ‘나’에서 클라우드 백업을 켜세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在此 iPhone 上。请在“我”中开启云备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存在此 iPhone 上。請在「我」中開啟雲端備份。"
          }
        }
      }
    },
    "Saved on this iPhone. Backup will try again shortly.": {
