    "1 change saved on this iPhone, waiting to back up": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 cambio guardado en este iPhone, esperando copia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modification enregistrée sur cet iPhone, en attente de sauvegarde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Änderung auf diesem iPhone gespeichert, wartet auf Backup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modifica salvata su questo iPhone, in attesa di backup"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 alteração salva neste iPhone, aguardando backup"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 wijziging bewaard op deze iPhone, wacht op back-up"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ändring sparad på den här iPhonen, väntar på backup"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ændring gemt på denne iPhone, venter på backup"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "1 endring lagret på denne iPhonen, venter på sikkerhetskopi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 zmiana zapisana na tym iPhonie czeka na kopię"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 изменение сохранено на этом iPhone и ждёт копирования"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "1 зміна збережена на цьому iPhone і чекає копіювання"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 değişiklik bu iPhone’a kaydedildi, yedeklenmeyi bekliyor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件の変更がこのiPhoneに保存され、バックアップを待っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 1개가 이 iPhone에 저장되어 백업을 기다리고 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 项更改已保存在此 iPhone 上，等待备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 項變更已儲存在此 iPhone 上，等待備份"
          }
        }
      }
    },
    "A drive to the doctor, a pharmacy run, a night at her place. Tap + and pick what you did.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje al médico, ir a la farmacia, una noche en su casa. Toca + y elige lo que hiciste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trajet chez le médecin, un passage à la pharmacie, une nuit chez elle. Touchez + et choisissez ce que vous avez fait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fahrt zum Arzt, ein Gang zur Apotheke, eine Nacht bei ihr. Tippe auf + und wähle, was du gemacht hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passaggio dal medico, un salto in farmacia, una notte da lei. Tocca + e scegli cosa hai fatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ida ao médico, uma passada na farmácia, uma noite na casa dela. Toque em + e escolha o que você fez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rit naar de dokter, even naar de apotheek, een nacht bij haar. Tik op + en kies wat je deed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur till läkaren, ett ärende till apoteket, en natt hos henne. Tryck på + och välj vad du gjorde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur til lægen, et smut på apoteket, en nat hos hende. Tryk på + og vælg, hvad du lavede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur til legen, et ærend på apoteket, en natt hos henne. Trykk på + og velg hva du gjorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjazd do lekarza, wizyta w aptece, noc u mamy. Stuknij + i wybierz czynność."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поездка к врачу, поход в аптеку, ночь у мамы. Нажмите + и выберите, что вы сделали."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поїздка до лікаря, похід в аптеку, ніч у мами. Натисніть + і виберіть, що ви зробили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doktora götürmek, eczaneye uğramak, onun yanında bir gece. + simgesine dokunun ve ne yaptığınızı seçin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通院の付き添い、薬局への買い出し、泊まり込み。＋をタップして、したことを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병원 모셔다드리기, 약국 다녀오기, 곁에서 하룻밤. +를 탭하고 한 일을 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开车送去看医生、去趟药店、在她家过夜。轻点 +，然后选择您做的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開車送去看醫生、跑一趟藥局、在她家過夜。點一下 +，然後選擇您做的事。"
          }
        }
      }
    },
    "A phone you lose afterwards cannot get them back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si después pierdes el iPhone, no podrás recuperarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous perdez ensuite votre iPhone, vous ne pourrez plus les récupérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlierst du danach dein iPhone, lassen sie sich nicht zurückholen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poi perdi l’iPhone, non potrai più recuperarle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você perder o iPhone depois, não será possível recuperá-los."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak je daarna je iPhone kwijt, dan krijg je ze niet meer terug."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du tappar bort telefonen efteråt går de inte att få tillbaka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mister du telefonen bagefter, kan de ikke hentes tilbage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mister du telefonen etterpå, kan de ikke hentes tilbake."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli potem zgubisz telefon, nie odzyskasz ich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если потом потеряете телефон, вернуть их будет нельзя."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо потім загубите телефон, повернути їх не вийде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonradan telefonu kaybederseniz onları geri alamazsınız."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後iPhoneをなくすと、記録は取り戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 iPhone을 잃어버리면 기록을 되찾을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后如果丢失手机，将无法找回这些记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後如果遺失手機，將無法找回這些紀錄。"
          }
        }
      }
    },
    "A record of what you paid, not tax advice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro de lo que pagaste, no asesoramiento fiscal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un relevé de ce que vous avez payé, pas un conseil fiscal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufstellung deiner Ausgaben, keine Steuerberatung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riepilogo di ciò che hai pagato, non una consulenza fiscale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um registro do que você pagou, não uma orientação fiscal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een overzicht van wat je betaalde, geen belastingadvies."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sammanställning av vad du betalat, inte skatterådgivning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En opgørelse af, hvad du har betalt, ikke skatterådgivning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En oversikt over hva du har betalt, ikke skatteråd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zestawienie twoich wydatków, a nie porada podatkowa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запись ваших расходов, а не налоговая консультация."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запис ваших витрат, а не податкова консультація."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödediklerinizin bir dökümüdür, vergi danışmanlığı değildir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払った内容の記録であり、税務上の助言ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낸 돈의 기록이며 세무 조언이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您付款的记录，不是税务建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是您付款的紀錄，不是稅務建議。"
          }
        }
      }
    },
    "A spreadsheet of every entry plus all receipt photos. Free, any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja de cálculo con cada registro y todas las fotos de recibos. Gratis, cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tableau de toutes les entrées et toutes les photos de reçus. Gratuit, à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tabelle mit allen Einträgen und allen Belegfotos. Kostenlos, jederzeit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio di calcolo con tutte le voci e tutte le foto delle ricevute. Gratis, quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma planilha com todos os registros e todas as fotos de recibos. Grátis, a qualquer momento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een spreadsheet met elk item plus alle bonfoto’s. Gratis, altijd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett kalkylblad med alla poster plus alla kvittofoton. Gratis, när som helst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et regneark med alle poster plus alle kvitteringsfotos. Gratis, når som helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et regneark med alle oppføringer pluss alle kvitteringsbilder. Gratis, når som helst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz ze wszystkimi wpisami i wszystkie zdjęcia paragonów. Za darmo, w każdej chwili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица со всеми записями и все фото чеков. Бесплатно, в любое время."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблиця з усіма записами та всі фото чеків. Безкоштовно, будь-коли."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kaydın yer aldığı bir tablo ve tüm fiş fotoğrafları. Ücretsiz, her zaman."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての記録をまとめた表と、すべての領収書の写真。無料でいつでも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기록이 담긴 스프레드시트와 모든 영수증 사진. 언제든지 무료입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份包含所有记录的表格，外加全部收据照片。随时免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一份包含所有紀錄的試算表，加上所有收據照片。隨時免費。"
          }
