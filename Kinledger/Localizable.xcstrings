          "stringUnit": {
            "state": "translated",
            "value": "Cela semble beaucoup pour un seul reçu. Vouliez-vous dire %@ ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist viel für einen Beleg. Meintest du %@?"
          }
        },
