        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: кто будет видеть, как идут дела?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: хто бачитиме, як ідуть справи?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nasıl, kimler görsün?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の様子を誰に知らせますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 소식을 누구와 나눌까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您想让谁了解%@的近况？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您想讓誰知道%@的近況？"
          }
        }
      }
    },
