    "Prices are not available right now. Try again later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios no están disponibles ahora. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix ne sont pas disponibles pour le moment. Réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise sind gerade nicht verfügbar. Versuch es später noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi non sono disponibili ora. Riprova più tardi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços não estão disponíveis agora. Tente mais tarde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijzen zijn nu niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserna är inte tillgängliga just nu. Försök igen senare."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserne er ikke tilgængelige lige nu. Prøv igen senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisene er ikke tilgjengelige akkurat nå. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny są teraz niedostępne. Spróbuj później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цены сейчас недоступны. Попробуйте позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціни зараз недоступні. Спробуйте пізніше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar şu anda kullanılamıyor. Daha sonra yeniden deneyin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、価格を取得できません。しばらくしてからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 가격을 확인할 수 없습니다. 나중에 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法获取价格。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法取得價格。請稍後再試。"
          }
        }
      }
    },
    "Prices could not load. Check the connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los precios. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix n’ont pas pu se charger. Vérifiez la connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preise konnten nicht geladen werden. Prüf die Verbindung und versuch es noch einmal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i prezzi. Controlla la connessione e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os preços. Verifique a conexão e tente de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijzen konden niet laden. Controleer de verbinding en probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserna kunde inte läsas in. Kontrollera anslutningen och försök igen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Priserne kunne ikke indlæses. Tjek forbindelsen, og prøv igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prisene kunne ikke lastes inn. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać cen. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить цены. Проверьте подключение и попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити ціни. Перевірте з’єднання і спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlar yüklenemedi. Bağlantıyı kontrol edip yeniden deneyin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格を読み込めませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격을 불러오지 못했습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载价格。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入價格。請檢查網路連線後再試一次。"
          }
        }
      }
    },
