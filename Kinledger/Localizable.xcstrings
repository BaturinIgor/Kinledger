          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece muito para um recibo só. Você quis dizer %@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat lijkt veel voor één bon. Bedoelde je %@?"
          }
        },
