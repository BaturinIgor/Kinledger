          "stringUnit": {
            "state": "translated",
            "value": "Apple nie potwierdziło. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не подтвердила. Попробуйте ещё раз."
